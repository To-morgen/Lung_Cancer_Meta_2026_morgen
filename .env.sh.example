# Copy to .env.sh and edit for your local machine.
# .env.sh is ignored by Git.

export PROJECT_ROOT="/path/to/Lung_Cancer_Meta_2026_morgen"
export DATA_ROOT="/path/to/lung_cancer_data"

# Optional dataset selection helpers.
# Use either DATASET_ID for legacy scripts or DS_CONFIG for explicit config loading.
export DATASET_ID=""
export DS_CONFIG="configs/datasets/_template.yaml"

# Optional raw-data / alignment hints for local setups.
# export FASTQ_SOURCE="${DATA_ROOT}/raw"
# export CELLRANGER_BIN="/path/to/cellranger"
# export CELLRANGER_REF="/path/to/reference"
# export SINGULARITY_BIN="/path/to/singularity"
