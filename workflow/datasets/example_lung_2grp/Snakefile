"""
Snakefile — example 2-group lung cancer scRNA workflow
"""
import os

SNAKEFILE_DIR = workflow.basedir
PROJECT_ROOT  = os.path.normpath(os.path.join(SNAKEFILE_DIR, "..", "..", ".."))

configfile: workflow.source_path("config.yaml")

DS_PREFIX = config["ds_prefix"]
RESULTS   = os.path.join(PROJECT_ROOT, "results", "scrna", DS_PREFIX)
LOGS      = os.path.join(PROJECT_ROOT, "logs", "snakemake", DS_PREFIX)
SAMPLES   = config["samples"]

ENV_VARS = (
    f'DS_CONFIG="{os.path.join(PROJECT_ROOT, config["ds_config"])}" '
    f'DS_PREFIX="{DS_PREFIX}"'
)
DE_CONTRASTS_CONFIG = os.path.join(PROJECT_ROOT, config["de_contrasts_config"]) if config.get("de_contrasts_config") else ""

RSCRIPT = "/usr/bin/Rscript"

include: "../../snakemake/rules/gates.smk"
include: "../../snakemake/rules/phase01_alignment.smk"
include: "../../snakemake/rules/phase02_qc.smk"
include: "../../snakemake/rules/phase03_normalize.smk"
include: "../../snakemake/rules/phase04_integrate.smk"
include: "../../snakemake/rules/phase05_cluster.smk"
include: "../../snakemake/rules/phase06_annotate.smk"
include: "../../snakemake/rules/phase07_cnv.smk"
include: "../../snakemake/rules/phase08_de.smk"
include: "../../snakemake/rules/phase09_cellchat.smk"

