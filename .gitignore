# =========================================================
# .gitignore (Bioinformatics / R / Python / HPC)
# Philosophy: track code + configs + small key outputs;
#             ignore IDE caches, environments, logs, and bulky data.
# =========================================================

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# --- RStudio / R ---
.Rproj.user/        # MUST ignore: local IDE cache
.Rhistory           # Recommended ignore: command history may leak paths/tokens
.RData              # MUST ignore: workspace dump -> big + merge conflicts
.Ruserdata          # Recommended ignore: user state/cache
Rplots.pdf          # Default graphics device output; never a source artifact
# NOTE: Do NOT ignore *.Rproj (project anchor should be tracked)

# --- Python & Jupyter ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
.env                # MUST ignore if storing secrets
!.env.example       # Allow template for reproducible config

# --- Workflow & Environment (Snakemake/Conda/HPC) ---
.snakemake/         # MUST ignore: Snakemake runtime metadata
.conda/
.mamba/
# If you store only env YAMLs in envs/, keep YAMLs but ignore other things
envs/*
!envs/*.yml
!envs/*.yaml

slurm-*.out
slurm-*.err

# --- Logs / Temp / Cache ---
logs/
tmp/
*.log
*.err
core.*

# --- Data / Results / Figures (Code-Data Separation) ---
# Key point: ignore bulky directories, but keep structure with .gitkeep
data/
results/
figures/

# Keep directory placeholders (structure)
!data/.gitkeep
!results/.gitkeep
!figures/.gitkeep
!logs/.gitkeep
!metadata/.gitkeep
!scripts/.gitkeep

# Rendered manuscript figures remain private until an explicit release.
# Track generic plotting code and synthetic fixtures, not study outputs.

# --- Common Bioinformatics Bulky Formats ---
# Sequencing / Alignment
*.bam
*.bai
*.cram
*.crai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sam

# Variant / Index
*.vcf
*.vcf.gz
*.tbi

# Single-cell & Spatial Objects
*.h5ad
*.loom
*.rds
*.h5
*.mtx
*.mtx.gz

# Archives
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
# --- Data symlink ---
data

# --- R / renv ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# root renv: keep lockfile + activate script, ignore installed libraries
renv/library/
renv/staging/
renv/python/

# nested subprojects
**/.Rproj.user/
**/.Rhistory
**/.RData
**/.Ruserdata
**/renv/library/
**/renv/staging/
**/renv/python/

# local scratch drafts
scratch/*
!scratch/.gitkeep

# === Private configs (unpublished sample-specific) ===
configs_private/
!configs_private/.gitkeep

# === Subset test data ===
*_subset/
.env.sh

# Phase 1 — Cell Ranger outputs (tracked by path, not by git)
*.bam
*.bam.bai
*.bam.csi
*.h5
*.cloupe
cellranger_out/
fastq/
fastq_subset/
*.fastq.gz

# Snakemake internals
.snakemake/
**/.snakemake/

# Editor/IDE
.kilo/
.cursor/
.trellis/

# Local vendored tools
tools/

# Local notes / handoff drafts
Notes/
docs/HANDOFF_*.md

# Local analysis caches
workflow/datasets/**/.snakemake/

# Backup files
*.bak_*

# GBM-RHEB module data/results
modules/gbm_rheb_mtc/data
modules/gbm_rheb_mtc/results/
modules/gbm_rheb_mtc/logs/
modules/gbm_rheb_mtc/figures/
modules/gbm_rheb_mtc/scratch/
modules/gbm_rheb_mtc/renv/

# Module-local containers
modules/cnv/containers/
